@model IEnumerable<Assignment1.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<h1>Employee List</h1>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Employee ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Job Title</th>
        <th>Salary</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var employee in Model)
    {
        <tr>
            <td>@employee.EmployeeID</td>
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.JobTitle</td>
            <td>@employee.Salary.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="AddEmployee" class="btn btn-primary">Add New Employee</a>
<a asp-action="Browse" class="btn btn-secondary">Browse Employees</a>