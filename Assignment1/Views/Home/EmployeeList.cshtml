@model IEnumerable<Assignment1.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<h1>Employee List</h1>
<div class="my-4">
<a asp-action="AddEmployee" class="btn btn-outline-secondary"> ➕ Add New Employee</a>
<a asp-action="Browse" class="btn btn-outline-secondary"> 🔍 Browse Employees</a>
</div>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Employee ID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Job Title</th>
        <th>Salary</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var employee in Model)
    {
        <tr>
            <td>@employee.EmployeeID</td>
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.JobTitle</td>
            <td>@employee.Salary.ToString("C")</td>
            <td>
                
                <a asp-action="Browse" asp-route-id="@(employee.EmployeeID-1)" class="text-decoration-underline">
                    👁️ View
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
